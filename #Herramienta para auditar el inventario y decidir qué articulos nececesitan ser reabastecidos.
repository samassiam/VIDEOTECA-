#Herramienta para auditar el inventario y decidir qué articulos nececesitan ser reabastecidos.

#Matriz de inventario
#código, nombre, stock actual, estock mínimo.

inventario = [
    [101, "Arroz", 20, 50],
    [102, "Azúcar", 60, 40],
    [103, "Aceite", 10, 30],
    [104, "Frijol", 4, 25],
    [105, "Sal", 50, 20]
]

#Función (Módulo) para auditar el inventario
def clcular_pedido(stock_actual, stock_minimo):
    if stock_actual < stock_minimo:
        return stock_minimo - stock_actual
    else:
        return 0
    
#Proceso y salida del reporte

print("LISTA DE PEDIDOS DE INVENTARIO")
print("Código | Nombre  | Stock Actual | Stock Mínimo | Pedido")
print("-------------------------------------------------------------")  

for articulo in inventario:
    codigo = articulo[0]
    nombre = articulo[1]
    stock_actual = articulo[2]
    stock_minimo = articulo[3]

    cantidad_pedir = clcular_pedido(stock_actual, stock_minimo)

    if cantidad_pedir > 0:
        print(f"{nombre}: pedir {cantidad_pedir} unidades. ")
else:
    print(f"{nombre}: no es necesario pedir. ")
